<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisualStudio.CSharpNavigator.Server\VisualStudio.CSharpNavigator.Server.csproj" />
    <ProjectReference Include="..\..\src\VisualStudio.CSharpNavigator.Roslyn\VisualStudio.CSharpNavigator.Roslyn.csproj" />
    <ProjectReference Include="..\VisualStudio.CSharpNavigator.Bridge.TestHost\VisualStudio.CSharpNavigator.Bridge.TestHost.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\..\src\VisualStudio.CSharpNavigator.Vsix\Bridge\PipeBridgeContracts.cs" Link="Bridge\PipeBridgeContracts.cs" />
    <Compile Include="..\..\src\VisualStudio.CSharpNavigator.Vsix\Bridge\PipeBridgeRequestDispatcher.cs" Link="Bridge\PipeBridgeRequestDispatcher.cs" />
  </ItemGroup>

  <Target Name="CopyBridgeTestHost" AfterTargets="Build">
    <ItemGroup>
      <BridgeTestHostFiles Include="..\VisualStudio.CSharpNavigator.Bridge.TestHost\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeTestHostFiles)" DestinationFiles="@(BridgeTestHostFiles->'$(OutDir)bridge-test-host\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
